{
    "name": "@begame/trace",
    "version": "0.1.0",
    "description": "BEGame Trace: codec, session manager and history store, plus the Minecraft binding",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": ["dist"],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./minecraft": {
            "types": "./dist/minecraft.d.ts",
            "import": "./dist/minecraft.js"
        },
        "./server-net": {
            "types": "./dist/serverNet.d.ts",
            "import": "./dist/serverNet.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js"
        }
    },
    "dependencies": {
        "@begame/trace-spec": "0.1.0"
    },
    "peerDependencies": {
        "@begame/core": "0.1.0",
        "@minecraft/server": ">=2.10.0",
        "@minecraft/server-net": "*"
    },
    "peerDependenciesMeta": {
        "@begame/core": {
            "optional": true
        },
        "@minecraft/server": {
            "optional": true
        },
        "@minecraft/server-net": {
            "optional": true
        }
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/XiaoYangx666/SAPI-Game.git",
        "directory": "packages/trace"
    },
    "keywords": ["minecraft", "bedrock", "trace", "runtime"]
}
