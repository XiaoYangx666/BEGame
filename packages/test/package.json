{
    "name": "@begame/test",
    "version": "0.1.0",
    "description": "Headless lifecycle test engine for BEGame",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": ["dist"],
    "sideEffects": ["./dist/register.js"],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./register": {
            "import": "./dist/register.js"
        },
        "./vitest": {
            "types": "./dist/vitest.d.ts",
            "import": "./dist/vitest.js"
        }
    },
    "dependencies": {
        "@begame/core": "0.1.0",
        "@begame/trace": "0.1.0"
    },
    "peerDependencies": {
        "vitest": ">=5.0.0 <6.0.0"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/XiaoYangx666/BEGame.git",
        "directory": "packages/test"
    },
    "keywords": ["minecraft", "bedrock", "testing", "vitest", "headless"]
}
