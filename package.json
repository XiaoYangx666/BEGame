{
    "name": "begame-monorepo",
    "private": true,
    "version": "0.1.0",
    "description": "BEGame - Minecraft Bedrock game lifecycle framework",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "clean": "rimraf packages/core/dist packages/test/dist packages/trace/dist packages/trace-spec/dist || true",
        "build": "npm run clean && tsc --noEmit && rolldown -c && npm run build:observatory",
        "build:observatory": "npm run build --workspace @begame/observatory",
        "pack": "node scripts/pack.mjs",
        "release": "node scripts/publish.mjs",
        "test": "vitest run",
        "test:unit": "vitest run",
        "test:treeshake": "node scripts/treeshake-probe.mjs",
        "test:headless": "vitest run tests/lifecycle.test.mjs",
        "test:watch": "vitest",
        "fixture:observatory": "node scripts/make-observatory-fixture.mjs",
        "observatory": "node packages/observatory/dist/cli.js",
        "observatory:connect": "node packages/observatory/dist/cli.js --connect",
        "observatory:net": "node packages/observatory/dist/cli.js --net",
        "release:check": "node scripts/publish.mjs --dry-run",
        "release:stable": "node scripts/publish.mjs --tag latest"
    },
    "devDependencies": {
        "@minecraft/server": "2.10.0",
        "@minecraft/server-net": "1.0.0-beta.1.26.51-stable",
        "@minecraft/server-ui": "2.2.0",
        "@minecraft/vanilla-data": "1.26.51",
        "rimraf": "^6.1.2",
        "rolldown": "^1.1.5",
        "rolldown-plugin-dts": "^0.27.6",
        "tinyglobby": "^0.2.17",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    }
}
